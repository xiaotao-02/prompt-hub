# Paste into Zeabur website service -> Variables -> Edit raw
# NEXT_PUBLIC_GOOGLE_CLIENT_ID must match API GOOGLE_CLIENT_ID (see output/zeabur-api-admin-paste.env)
# Generate snippets: .\scripts\zeabur-admin-google-env.ps1 -ClientId "xxx.apps.googleusercontent.com" -AdminEmail "you@gmail.com" -WebHost "ai-prompt-studio.zeabur.app" -ApiHost "ai-prompt-studio-api.zeabur.app"

# 自定义域名（生产）
NEXT_PUBLIC_SITE_URL=https://aipromptstudio.top
NEXT_PUBLIC_API_URL=https://api.aipromptstudio.top
# 临时 Zeabur 子域（验证阶段）
# NEXT_PUBLIC_SITE_URL=https://ai-prompt-studio.zeabur.app
# NEXT_PUBLIC_API_URL=https://ai-prompt-studio-api.zeabur.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_PRICING_ENABLED=
NEXT_PUBLIC_MOCK_PAY_ENABLED=
NEXT_PUBLIC_DEV_LOGIN_ENABLED=
