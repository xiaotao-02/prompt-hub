# 复制为 output/zeabur-smtp.env（已 gitignore），填写密钥后执行：
#   $env:ZEABUR_TOKEN = '<Zeabur API Key>'
#   .\scripts\apply-zeabur-smtp.ps1
#
# 方案 A：Gmail（与 ADMIN_EMAILS 同邮箱时最省事）
# 1. Google 账号 -> 安全 -> 两步验证 -> 应用专用密码
# 2. 将 16 位密码填入 SMTP_PASS（无空格）

EMAIL_FROM=AI Prompt Studio <your@gmail.com>
EMAIL_DEV_LOG=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=<gmail-app-password>

# 方案 B：Zeabur Email（https://zeabur.com/email，域名需验证）
# ZSEND_API_KEY=zs_xxxxxxxx
# ZSEND_FROM=noreply@your-verified-domain.com
# EMAIL_FROM=AI Prompt Studio <noreply@your-verified-domain.com>
