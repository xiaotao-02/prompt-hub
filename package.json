{
  "name": "prompt-hub",
  "version": "0.1.91",
  "description": "Prompt Hub · 右键任意图片，调用视觉大模型提取 AI 绘画提示词的 Chrome 扩展",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-icons.ts && vite",
    "dev:previews": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-previews.ps1",
    "build": "tsx scripts/generate-icons.ts && tsc --noEmit && vite build",
    "build:watch": "tsx scripts/generate-icons.ts && vite build --watch",
    "preview": "vite preview",
    "icons": "tsx scripts/generate-icons.ts",
    "icons:from-image": "powershell -ExecutionPolicy Bypass -File scripts/resize-icons.ps1 && tsx scripts/optimize-pngs.ts",
    "zip": "npm run build && tsx scripts/zip.ts",
    "package": "npm run zip",
    "release:store": "tsx scripts/release-store.ts",
    "cws:refresh-token": "npx -y chrome-webstore-upload-keys",
    "store:assets": "tsx scripts/make-store-assets.ts",
    "store:screenshots": "tsx scripts/make-store-screenshots.ts",
    "store:libtv": "tsx scripts/generate-store-assets-libtv.ts",
    "store:libtv:validate": "tsx scripts/validate-store-assets.ts",
    "docs:readme-images": "tsx scripts/prepare-readme-images.ts",
    "install:chrome": "tsx scripts/install-to-chrome.ts",
    "install:edge": "tsx scripts/install-to-chrome.ts --browser=edge",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "knip:all": "knip",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "playwright": "^1.50.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
