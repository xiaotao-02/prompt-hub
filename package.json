{
  "name": "prompt-hub",
  "version": "0.1.147",
  "description": "Prompt Hub · 右键任意图片，调用视觉大模型提取 AI 绘画提示词的 Chrome 扩展",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-icons.ts && vite",
    "dev:previews": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-previews.ps1",
    "build": "tsx scripts/generate-icons.ts && tsc --noEmit -p tsconfig.extension.json && vite build",
    "build:watch": "tsx scripts/generate-icons.ts && vite build --watch",
    "preview": "vite preview",
    "icons": "tsx scripts/generate-icons.ts",
    "icons:from-image": "powershell -ExecutionPolicy Bypass -File scripts/resize-icons.ps1 && tsx scripts/optimize-pngs.ts",
    "zip": "npm run build && tsx scripts/zip.ts",
    "package": "npm run zip",
    "release:store": "tsx scripts/release-store.ts",
    "store:open-submit": "powershell -ExecutionPolicy Bypass -File scripts/open-cws-submit.ps1",
    "check:launch-domain": "tsx scripts/checkLaunchDomain.ts",
    "cws:refresh-token": "npx -y chrome-webstore-upload-keys",
    "store:assets": "tsx scripts/make-store-assets.ts",
    "store:screenshots": "tsx scripts/make-store-screenshots.ts",
    "store:libtv": "tsx scripts/generate-store-assets-libtv.ts",
    "store:libtv:export-raw": "tsx scripts/export-libtv-raw.ts",
    "store:libtv:validate": "tsx scripts/validate-store-assets.ts",
    "docs:map": "tsx scripts/gen-architecture-map.ts",
    "docs:readme-images": "tsx scripts/prepare-readme-images.ts",
    "website:typecheck": "npm run typecheck --prefix website",
    "install:chrome": "tsx scripts/install-to-chrome.ts",
    "install:edge": "tsx scripts/install-to-chrome.ts --browser=edge",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --noEmit -p tsconfig.extension.json",
    "lint:eslint": "eslint src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "knip:all": "knip",
    "knip:website": "knip --workspace website",
    "test": "vitest run",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "setup:zpay": "node scripts/setup-zpay.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.7",
    "playwright": "^1.50.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
